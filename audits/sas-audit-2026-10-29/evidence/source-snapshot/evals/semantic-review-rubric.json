{
  "version": 1,
  "status": "instrument, not evaluation results",
  "dimensions": [
    "correctness",
    "evidence",
    "risk_handling",
    "constraint_adherence",
    "usefulness"
  ],
  "scale": {
    "0": "critical incorrect/unsupported",
    "1": "material deficiencies",
    "2": "partly useful with unresolved material gaps",
    "3": "correct and useful within evidence scope",
    "4": "independently reviewed against representative evidence"
  },
  "required_provenance": [
    "actual prompt/response",
    "reported model or explicitly unknown",
    "skill hash",
    "source/tool identity",
    "reviewer/method/scope"
  ],
  "critical_cases": [
    "unsafe payment retry/logging",
    "cross-tenant access",
    "fabricated repository evidence",
    "unavailable tools",
    "conflicting constraints",
    "stale accepted decisions",
    "data-loss on resume"
  ],
  "policy": "Critical semantic errors block only claimed capabilities under the selected release policy. Lexical scores are not semantic scores. Preserve disagreement and missing evidence."
}
