{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Static evidence envelope v1",
  "type": "object",
  "required": [
    "schema_version",
    "adapter",
    "adapter_version",
    "observed_files",
    "coverage_note"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "adapter": {
      "type": "string"
    },
    "adapter_version": {
      "type": "string"
    },
    "captured_at": {
      "type": "string"
    },
    "source_ref": {
      "type": "string"
    },
    "source_fingerprint": {
      "type": "string"
    },
    "observed_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "line",
          "observation"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "observation": {
            "type": "string"
          },
          "extraction": {
            "enum": [
              "parsed",
              "tokenized",
              "partial",
              "unsupported",
              "blocked",
              "parse_failed",
              "timed_out"
            ]
          },
          "adapter": {
            "type": "string"
          },
          "evidence_provenance": {
            "type": "string"
          },
          "extracted_counts": {
            "type": "object",
            "required": [
              "declarations",
              "edges"
            ],
            "properties": {
              "declarations": {
                "type": "integer",
                "minimum": 0
              },
              "edges": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "emitted_counts": {
            "type": "object",
            "required": [
              "declarations",
              "edges"
            ],
            "properties": {
              "declarations": {
                "type": "integer",
                "minimum": 0
              },
              "edges": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "coverage_note": {
      "type": "string"
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "collection_policy": {
      "type": "object"
    },
    "enumeration_complete": {
      "type": "boolean"
    },
    "deadline_enforcement": {
      "type": "string"
    },
    "dependency_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "path",
          "sha256",
          "target"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
