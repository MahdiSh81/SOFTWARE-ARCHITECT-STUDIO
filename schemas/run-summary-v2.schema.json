{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Minimized run summary v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_schema",
    "run_id",
    "toolkit_version",
    "command",
    "duration_seconds",
    "status",
    "operation_status",
    "exit_code",
    "policy_ok",
    "ok",
    "error_code",
    "check_count",
    "check_status_counts",
    "input_source_hash",
    "observed_files",
    "bytes_read",
    "tokens",
    "scope",
    "retention",
    "completed_at"
  ],
  "properties": {
    "receipt_schema": {
      "const": 2
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "toolkit_version": {
      "type": "string"
    },
    "command": {
      "type": "string"
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "operation_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "exit_code": {
      "type": "integer"
    },
    "policy_ok": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "ok": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "check_count": {
      "type": "integer",
      "minimum": 0
    },
    "check_status_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "input_source_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "observed_files": {
      "type": "integer",
      "minimum": 0
    },
    "bytes_read": {
      "type": [
        "integer",
        "null"
      ]
    },
    "tokens": {
      "const": "unreported"
    },
    "scope": {
      "const": "minimized run telemetry, not a verification receipt"
    },
    "retention": {
      "type": "string"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
