{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local skill inventory v1",
  "type": "object",
  "required": [
    "schema_version",
    "skills",
    "scope"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scope": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "description",
          "version",
          "sha256",
          "bytes",
          "references"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^skills/"
          },
          "description": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 256000
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
