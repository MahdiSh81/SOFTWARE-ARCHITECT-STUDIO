{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://software-architect-studio.local/schemas/tool-capability-v1.schema.json",
  "title": "Tool capability manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_id",
    "tool_version",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "tool_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"
    },
    "tool_version": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "description",
          "permission_class",
          "input_schema",
          "output_schema",
          "idempotent",
          "timeout_seconds"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "permission_class": {
            "enum": [
              "read",
              "write",
              "deploy",
              "production_data"
            ]
          },
          "input_schema": {
            "type": "object"
          },
          "output_schema": {
            "type": "object"
          },
          "idempotent": {
            "type": "boolean"
          },
          "timeout_seconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 3600
          }
        }
      },
      "maxItems": 100
    }
  }
}
