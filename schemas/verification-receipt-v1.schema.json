{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://software-architect-studio.local/schemas/verification-receipt-v1.schema.json",
  "title": "Tool result and verification receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id",
    "tool_id",
    "tool_version",
    "capability",
    "permission_class",
    "input_source_hash",
    "input_schema_version",
    "started_at",
    "completed_at",
    "status",
    "checks_run",
    "checks_not_run",
    "warnings",
    "errors",
    "limitations"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "tool_id": {
      "type": "string",
      "minLength": 1
    },
    "tool_version": {
      "type": "string",
      "minLength": 1
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "permission_class": {
      "enum": [
        "read",
        "write",
        "deploy",
        "production_data"
      ]
    },
    "input_source_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input_schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "blocked",
        "timed_out",
        "skipped",
        "partial",
        "unknown",
        "tool_error",
        "not_run_due_to_budget"
      ]
    },
    "output_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 10000
    },
    "checks_run": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 10000
    },
    "checks_not_run": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 10000
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 10000
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 10000
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 10000
    },
    "authorization_reference": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "output_source_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observed_effects": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 10000
    },
    "details": {
      "type": "object"
    },
    "receipt_status": {
      "enum": [
        "failed"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "passed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "output_hash"
        ],
        "properties": {
          "output_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "errors": {
            "maxItems": 0
          },
          "checks_not_run": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "permission_class": {
            "enum": [
              "write",
              "deploy",
              "production_data"
            ]
          }
        },
        "required": [
          "permission_class"
        ]
      },
      "then": {
        "required": [
          "authorization_reference"
        ],
        "properties": {
          "authorization_reference": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
